#!/usr/bin/env node
/**
 * ball — say what you are doing, on the floating ball.
 *
 * The ball is the only thing the user sees while they are in another app, and the
 * page scraping the conversation turned out to be a bad source for it: rows arrive
 * out of order, half the steps never produce one, and what did show up was a
 * fragment. So the status has a channel of its own — this command. You say what
 * you are doing in one line, and that line is what the bubble shows.
 *
 * That line has a name in the protocol: `ball_doing`. Every step of a
 * conversation the ball opened carries one, empty means "nothing running", and
 * this command is where it is published:
 *
 *   ball "正在构建 t3 载荷"     a step: the ball ticks ◐◓◑◒ next to this line
 *   ball --doing "正在构建…"    the same thing, with the field spelled out
 *   ball --json '{"ball_doing":"正在构建…"}'   a JSON body straight from the model
 *   ball think                 between steps: the ball rotates its waiting labels
 *   ball done "已给出答案"      finished: ✓ + this line, then it fades out
 *   ball idle                  clear it (ball_doing is the empty string)
 *   ball --status              what the ball is showing right now
 *
 * It goes to the app's loopback control bridge, so it only does anything while
 * the ball is switched on; with the ball off the call is still a success and the
 * status simply is not shown.
 *
 * Exit codes: 0 ok, 2 bridge/protocol trouble, 3 no bridge to talk to.
 */
import { existsSync, readFileSync } from "node:fs";

const BRIDGE_EXIT = 2;
const USAGE = `ball — 把"你在干什么"写到悬浮球上

  ball "<一句话>"        开始一个步骤（球上会转 ◐◓◑◒ + 这句话）
  ball --doing "<一句话>"  同上，字段名写全（ball_doing）
  ball --json '{"ball_doing":"…"}'  直接给一份 JSON（可带 phase）
  ball think             步骤之间的思考（球上轮换"思索中…/烘焙中…/喵喵喵…"）
  ball done ["一句话"]   结束（✓ + 这句话，然后淡出）
  ball idle              清掉（ball_doing 为空串）
  ball --status          看球现在显示什么
`;

/**
 * The `ball_doing` field out of whatever the model handed over.
 *
 * Models wrap JSON in prose or a fenced block, and a shell argument can arrive
 * with the braces of a copy-paste. Anything that is not a JSON object with a
 * `ball_doing` is taken as the line itself, so the plain form keeps working.
 */
function parseDoing(raw) {
  const text = String(raw ?? "").trim();
  if (text === "") return { doing: "", phase: "" };
  const start = text.indexOf("{");
  const end = text.lastIndexOf("}");
  if (start >= 0 && end > start) {
    try {
      const parsed = JSON.parse(text.slice(start, end + 1));
      if (parsed !== null && typeof parsed === "object" && !Array.isArray(parsed)) {
        const doing = parsed.ball_doing ?? parsed.doing ?? parsed.text;
        if (typeof doing === "string") {
          const phase = typeof parsed.phase === "string" ? parsed.phase : "";
          return { doing: doing.trim(), phase: phase.trim() };
        }
      }
    } catch {
      /* not JSON: a model can hand a literal newline inside a string, which no
         parser accepts. Fall through to the field-level repair below. */
    }
    const field = /"ball_doing"\s*:\s*"((?:[^"\\]|\\.)*)"/.exec(text);
    if (field) {
      const doing = field[1].replace(/\\n/g, "\n").replace(/\\"/g, '"').trim();
      const phase = /"phase"\s*:\s*"([^"]*)"/.exec(text);
      return { doing, phase: phase ? phase[1].trim() : "" };
    }
    return { doing: text, phase: "" };
  }
  return { doing: text, phase: "" };
}


function findBridge() {
  const url = process.env.DSH_ANDROID_BRIDGE_URL;
  const token = process.env.DSH_ANDROID_BRIDGE_TOKEN;
  if (url && token) return { url, token };
  // Outside the harness process tree (a plain shell in the sandbox), the app
  // leaves the same two values in a file before it launches the guest.
  for (const path of ["/etc/dsh-android/bridge.env", "/root/.dsh-android-bridge.env"]) {
    if (!existsSync(path)) continue;
    const values = {};
    for (const line of readFileSync(path, "utf8").split("\n")) {
      const match = /^\s*([A-Z_]+)\s*=\s*(.*)\s*$/.exec(line);
      if (match) values[match[1]] = match[2].replace(/^["']|["']$/g, "");
    }
    if (values.DSH_ANDROID_BRIDGE_URL && values.DSH_ANDROID_BRIDGE_TOKEN) {
      return { url: values.DSH_ANDROID_BRIDGE_URL, token: values.DSH_ANDROID_BRIDGE_TOKEN };
    }
  }
  console.error("ball: 找不到控制桥（DSH_ANDROID_BRIDGE_URL/TOKEN，或 /etc/dsh-android/bridge.env）");
  process.exit(BRIDGE_EXIT);
}

async function state(body) {
  const bridge = findBridge();
  const response = await fetch(bridge.url + "/ball/state", {
    method: body === undefined ? "GET" : "POST",
    headers: Object.assign({ "X-Dsh-Token": bridge.token },
      body === undefined ? {} : { "Content-Type": "application/json" }),
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  const text = await response.text();
  if (response.status === 404) {
    // An older shell has no status channel. Not an error the caller should have to
    // handle on every step: say so once and succeed.
    console.log("ball: 这个外壳还没有状态通道（/ball/state），跳过");
    process.exit(0);
  }
  if (!response.ok) {
    console.error("ball: 控制桥返回 HTTP " + response.status + (text ? "：" + text.slice(0, 160) : ""));
    process.exit(BRIDGE_EXIT);
  }
  let data;
  try {
    data = text ? JSON.parse(text) : {};
  } catch {
    console.error("ball: 桥的响应不是 JSON：" + text.slice(0, 160));
    process.exit(BRIDGE_EXIT);
  }
  return data.state ?? {};
}

const argv = process.argv.slice(2);
const command = argv[0];

try {
  if (command === undefined || command === "--help" || command === "-h") {
    console.log(USAGE.trimEnd());
    process.exit(0);
  }

  if (command === "--status" || command === "status") {
    const current = await state();
    const phases = { work: "干活中", think: "思考中", done: "刚结束", idle: "没有状态" };
    console.log(`悬浮球${current.running === true ? "开着" : "没开"} · ${phases[current.phase] ?? current.phase}`
      + (current.text ? ` · ${current.text}` : "")
      + (current.age ? `（${Math.round(current.age / 1000)} 秒前）` : ""));
    process.exit(0);
  }

  if (command === "think") {
    const current = await state({ phase: "think", text: "" });
    console.log("ball: 思考中" + (current.running === true ? "" : "（悬浮球没开，没显示）"));
    process.exit(0);
  }

  if (command === "idle" || command === "clear") {
    await state({ phase: "idle", text: "" });
    console.log("ball: 已清掉");
    process.exit(0);
  }

  if (command === "done") {
    const parsed = parseDoing(argv.slice(1).join(" "));
    const current = await state({ phase: "done", text: parsed.doing, ball_doing: parsed.doing });
    console.log("ball: 完成" + (current.running === true ? "" : "（悬浮球没开，没显示）"));
    process.exit(0);
  }

  /* `ball --doing "<line>"` and `ball --json '{"ball_doing":"…"}'`: the same
     status as the plain form, with the protocol's own field name. The body always
     carries both `text` (what every shell since t2 reads) and `ball_doing` (the
     name the contract uses), so an older app is unaffected. */
  if (command === "--doing" || command === "--json" || command === "--ball-doing") {
    const parsed = parseDoing(argv.slice(1).join(" "));
    // An empty ball_doing means "nothing running": the bubble folds back into the
    // ball instead of showing an empty capsule.
    const phase = parsed.phase || (parsed.doing ? "work" : "idle");
    const current = await state({ phase, text: parsed.doing, ball_doing: parsed.doing });
    console.log("ball: " + (parsed.doing || "（空，收起）")
      + (current.running === true ? "" : "（悬浮球没开，没显示）"));
    process.exit(0);
  }

  const parsed = parseDoing(argv.join(" "));
  const text = parsed.doing;
  if (text.length === 0) {
    console.error(USAGE.trimEnd());
    process.exit(2);
  }
  const current = await state({ phase: parsed.phase || "work", text, ball_doing: text });
  console.log("ball: " + text + (current.running === true ? "" : "（悬浮球没开，没显示）"));
} catch (error) {
  console.error("ball: " + (error && error.message ? error.message : String(error)));
  process.exit(BRIDGE_EXIT);
}
