{
  "name": "@local/dsh-market",
  "version": "1.0.0",
  "private": true,
  "description": "右侧栏「插件市场」：列出可安装的插件（官方随包 / npm 在线目录 / 已安装），一键安装、启用、停用",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "meta": {
    "title": "插件市场",
    "description": "在右侧栏列出可安装的插件：官方随包、npm 在线目录、已安装；一键安装、启用、停用，失败给出可读原因。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
