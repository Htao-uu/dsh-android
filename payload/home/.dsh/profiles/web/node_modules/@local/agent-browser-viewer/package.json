{
  "name": "@local/agent-browser-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "右侧栏「Agent 浏览器」标签页：实时显示 agent 无头浏览器的最新截图",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "meta": {
    "title": "Agent 浏览器",
    "description": "在右侧栏开一个标签页，实时刷新 agent 无头浏览器的最新截图。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
